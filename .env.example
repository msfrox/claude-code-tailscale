# Copy to .env and fill in. Used by docker compose.

# Hostname this node advertises on your tailnet.
TS_HOSTNAME=claude-code

# Optional: Tailscale auth key for an unattended first join.
# Generate at: Tailscale admin console -> Settings -> Keys -> Generate auth key.
# Leave blank to authenticate interactively via the login URL printed in logs.
# After the first successful join this is no longer needed (state is persisted).
TS_AUTHKEY=

# Extra flags appended (unquoted, word-split) to `tailscale up`, e.g. to
# advertise routes or accept them: TS_EXTRA_ARGS=--advertise-routes=10.0.1.0/24
# Leave blank for just --ssh --hostname=$TS_HOSTNAME --accept-dns=false.
TS_EXTRA_ARGS=

# Where projects are stored on the host (bind-mounted to /workspace in the
# container). Defaults to ./projects next to the compose file. Point this at a
# NAS/array path to keep projects on persistent storage, e.g.:
#   WORKSPACE_PATH=/mnt/your/nas/path/Projects
WORKSPACE_PATH=./projects

# Pin the Tailscale identity/state and the node-user home dir to host paths
# instead of the default named volumes (e.g. to migrate an existing
# container's identity, or keep them on a specific array/cache path). Leave
# blank to keep using the named volumes (tailscale-state, node-home) — see
# "Using host bind mounts instead of named volumes" in the README.
#   TAILSCALE_PATH=/mnt/user/appdata/claude-code/tailscale
#   HOME_PATH=/mnt/user/appdata/claude-code/home
TAILSCALE_PATH=
HOME_PATH=

# --- Claude Code Remote Control (optional) -----------------------------------
# Drive this container from claude.ai/code and the Claude mobile app (Code tab).
# Set to 1 to enable. Requires a one-time `claude` login inside the container
# (SSH in, run `claude`, then /login); the login persists in /home/node.
RC_ENABLE=
# Session title shown in the app. Defaults to TS_HOSTNAME if left blank.
RC_NAME=
# Directory Remote Control serves sessions in.
RC_DIR=/workspace
# Extra flags appended (unquoted, word-split) to `claude remote-control`.
RC_EXTRA_ARGS=
